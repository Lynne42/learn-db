# ==============================================================================
# MySQL 8.0 生产级核心服务配置文件 (my.cnf)
# ==============================================================================

[client]
port = 3306
default-character-set = utf8mb4

[mysqld]
# ------------------------------------------------------------------------------
# 1. 基础与网络配置
# ------------------------------------------------------------------------------
user = mysql
port = 3306
bind-address = 0.0.0.0          # 允许所有 IP 连接（容器环境必须）
character-set-server = utf8mb4  # 强制支持表情包和完整中文字符集
collation-server = utf8mb4_general_ci

# ------------------------------------------------------------------------------
# 2. 连接与并发控制
# ------------------------------------------------------------------------------
max_connections = 1000          # 最大并发连接数。过大会耗尽系统内存，过小会报 Too many connections
max_user_connections = 800      # 单个用户最大连接数
max_allowed_packet = 64M        # 单条 SQL 或接收的数据包最大大小（防止大文件或长文本撑爆连接）
interactive_timeout = 7200      # 交互式连接空闲超时（秒）
wait_timeout = 1800             # 非交互式连接（如后端连接池）空闲超时，超时自动断开，防止死连接占坑

# ------------------------------------------------------------------------------
# 3. 内存与存储引擎优化 (InnoDB 核心)
# ------------------------------------------------------------------------------
# 【生死线】物理内存的 50% - 70%。例如服务器 8G 内存，这里写 4G 或 5G。
# 它是 MySQL 性能的绝对核心，将热点数据和索引全部缓存在内存中。
innodb_buffer_pool_size = 4G    

innodb_flush_log_at_trx_commit = 1  # 0: 每秒刷盘; 1: 每次事务提交都刷盘(最安全,防断电); 2: 操作系统崩溃才丢数据
innodb_log_buffer_size = 16M        # 事务日志缓冲区大小
innodb_file_per_table = 1           # 独立表空间：每张表独立占用一个物理文件，方便管理和回收空间

# ------------------------------------------------------------------------------
# 4. 安全与规范控制 (你的痛点)
# ------------------------------------------------------------------------------
# 强制开启安全更新模式，禁止无索引或无 WHERE 的 UPDATE/DELETE
sql_safe_updates = 1

# 严格模式：拒绝非法数据插入（如长度超限、类型不符直接报错，而不是静默截断）
sql_mode = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION

# ------------------------------------------------------------------------------
# 5. 日志与性能审计 (架构师的眼睛)
# ------------------------------------------------------------------------------
log_error = /var/log/mysql/error.log  # 错误日志路径

# 慢查询日志：揪出线上慢 SQL 的唯一标准
slow_query_log = 1
slow_query_log_file = /var/log/mysql/mysql-slow.log
long_query_time = 1.0           # 执行时间超过 1.0 秒的 SQL 将被强行记录，留待后续追责重构
log_queries_not_using_indexes = 1 # 如果 SQL 没走索引，即使速度快也强行记录到慢日志中